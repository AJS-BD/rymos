# RYmos environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Required — Supabase project URL (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required — Supabase anon (public) key (same place as above)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server only — Supabase service-role key.
# No NEXT_PUBLIC_ prefix: never expose it to the browser.
# Only needed by server-side code that must bypass RLS (e.g. a future
# server-side checkout route). Leave it unset unless such a route uses it.
SUPABASE_SERVICE_ROLE_KEY=
